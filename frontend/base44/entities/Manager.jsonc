{
  "name": "Manager",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization (tenant)",
      "default": "default"
    },
    "full_name": {
      "type": "string",
      "title": "Nome"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "role": {
      "type": "string",
      "enum": [
        "superadmin",
        "delegated_admin",
        "operator",
        "viewer"
      ],
      "default": "viewer",
      "title": "Role global"
    },
    "scope_saas": {
      "type": "string",
      "title": "Escopo SaaS (ids ou * )"
    },
    "scope_tenant": {
      "type": "string",
      "title": "Escopo tenant"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "title": "2FA"
    },
    "temporary_access_until": {
      "type": "string",
      "format": "date-time",
      "title": "Acesso tempor\u00e1rio at\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "expired",
        "break_glass"
      ],
      "default": "active",
      "title": "Status"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltima atividade"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}