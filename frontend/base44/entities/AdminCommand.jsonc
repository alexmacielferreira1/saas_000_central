{
  "name": "AdminCommand",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization (tenant)",
      "default": "default"
    },
    "operation_id": {
      "type": "string",
      "title": "Operation ID"
    },
    "saas": {
      "type": "string",
      "title": "SaaS alvo"
    },
    "tenant": {
      "type": "string",
      "title": "Tenant"
    },
    "resource": {
      "type": "string",
      "title": "Recurso"
    },
    "action": {
      "type": "string",
      "title": "A\u00e7\u00e3o"
    },
    "requested_by": {
      "type": "string",
      "title": "Solicitante"
    },
    "permission": {
      "type": "string",
      "title": "Permiss\u00e3o usada"
    },
    "patch": {
      "type": "string",
      "title": "Patch / before-after"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validating",
        "awaiting_confirmation",
        "queued",
        "executing",
        "succeeded",
        "partial_success",
        "failed",
        "cancelled",
        "rolled_back"
      ],
      "default": "draft",
      "title": "Status"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "title": "Tentativas"
    },
    "result": {
      "type": "string",
      "title": "Resultado"
    },
    "audit_ref": {
      "type": "string",
      "title": "Refer\u00eancia de auditoria"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "title": "Dry run"
    }
  },
  "required": [
    "saas",
    "action"
  ]
}