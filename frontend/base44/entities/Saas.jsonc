{
  "name": "Saas",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization (tenant)",
      "default": "default"
    },
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "version": {
      "type": "string",
      "title": "Vers\u00e3o"
    },
    "base_url": {
      "type": "string",
      "title": "Base URL"
    },
    "icon": {
      "type": "string",
      "title": "\u00cdcone (lucide)"
    },
    "color": {
      "type": "string",
      "title": "Cor (hex)"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "limited",
        "incompatible",
        "auth_failed",
        "unavailable"
      ],
      "default": "unavailable",
      "title": "Status de integra\u00e7\u00e3o"
    },
    "health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "down",
        "unknown"
      ],
      "default": "unknown",
      "title": "Health"
    },
    "admin_api_version": {
      "type": "string",
      "title": "Admin API version"
    },
    "compatibility": {
      "type": "string",
      "enum": [
        "supported",
        "deprecated",
        "limited",
        "incompatible"
      ],
      "default": "limited",
      "title": "Compatibilidade"
    },
    "integration_level": {
      "type": "string",
      "enum": [
        "inventory",
        "read",
        "users_config",
        "write_controlled",
        "domain_resources",
        "automation"
      ],
      "default": "inventory",
      "title": "N\u00edvel de integra\u00e7\u00e3o"
    },
    "capabilities_summary": {
      "type": "string",
      "title": "Resumo de capabilities"
    },
    "last_handshake": {
      "type": "string",
      "format": "date-time",
      "title": "\u00daltimo handshake"
    },
    "tenant_count": {
      "type": "number",
      "default": 0,
      "title": "Tenants"
    },
    "user_count": {
      "type": "number",
      "default": 0,
      "title": "Usu\u00e1rios"
    }
  },
  "required": [
    "name"
  ]
}