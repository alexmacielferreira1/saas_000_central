{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "incident_to_linear",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_linear_issue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createLinearIssueFromIncident",
            "args": {
              "incident_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Criar tarefa no Linear",
            "description": "Issue a partir do incidente aberto"
          }
        }
      }
    ]
  },
  "name": "Incident to Linear",
  "description": "Cria automaticamente uma tarefa no Linear sempre que um incidente \u00e9 aberto na Central SaaS.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Incident"
    }
  }
}